{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:screen_mirror_background_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": [
          "audioRecording",
          "multiDeviceConnection"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "entities": [
              "entity.system.default"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "application/pdf"
              },
              {
                "scheme": "datashare",
                "type": "application/pdf"
              }
            ]
          }
        ]
      }
    ],
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "extensionAbilities": [
      {
        "name": "SendToMacAbility",
        "srcEntry": "./ets/share/SendToMacAbility.ets",
        "type": "share",
        "label": "$string:send_to_mac_label",
        "icon": "$media:app_icon",
        "description": "$string:send_to_mac_desc",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData",
              "ohos.want.action.sendMultipleData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.file",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.image",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.video",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.audio",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "com.adobe.pdf",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.archive",
                "maxFileSupported": 9
              },
              {
                "scheme": "datashare",
                "type": "*/*",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "type": "*/*",
                "maxFileSupported": 9
              }
            ]
          }
        ]
      }
    ]
  }
}
